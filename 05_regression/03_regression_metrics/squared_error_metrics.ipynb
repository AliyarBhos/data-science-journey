   "outputs": [],
   "source": [
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "91bec571",
   "metadata": {},
   "outputs": [],
   "source": [
    "actual = np.array([15, 25, 35, 45, 55])\n",
    "predicted = np.array([18, 22, 38, 42, 52])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "aaee34cb",
   "metadata": {},
   "outputs": [],
   "source": [
    "MSE = np.sum((np.abs(actual - predicted))**2) / len(actual)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "c78905ca",
   "metadata": {},
   "outputs": [],
   "source": [
    "RMSE = np.sqrt(MSE)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 11,
   "id": "8f7f17f5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "3.0\n",
      "9.0\n"
     ]
    }
   ],
   "source": [
    "print(RMSE)\n",
    "print(MSE)"
   ]
  }
